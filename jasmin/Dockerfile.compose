FROM python:3.12-slim-bookworm

RUN groupadd -r jasmin && useradd -r -g jasmin jasmin
RUN apt-get update && apt-get install -y --no-install-recommends libffi-dev libssl-dev supervisor libjemalloc2 && rm -rf /var/lib/apt/lists/*
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
WORKDIR /usr/jasmin

COPY requirements.txt requirements-test.txt setup.py README.rst ./
COPY jasmin ./jasmin
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir .

ENV UNICODEMAP_JP=unicode-ascii
ENV ROOT_PATH=/
ENV CONFIG_PATH=/etc/jasmin
ENV RESOURCE_PATH=/etc/jasmin/resource
ENV STORE_PATH=/etc/jasmin/store
ENV LOG_PATH=/var/log/jasmin

RUN mkdir -p /etc/jasmin/resource /etc/jasmin/store /var/log/jasmin \
    && chown -R jasmin:jasmin /etc/jasmin/store /var/log/jasmin
COPY misc/config/*.cfg ${CONFIG_PATH}/
COPY misc/config/resource ${RESOURCE_PATH}
COPY docker/docker-entrypoint.sh /jasmin-upstream-entrypoint.sh
COPY docker/compose-entrypoint.sh /compose-entrypoint.sh
COPY docker/provision-default.py /provision-default.py
RUN chmod +x /jasmin-upstream-entrypoint.sh /compose-entrypoint.sh \
    && sed -i '/\[jcli\]/a bind=0.0.0.0' ${CONFIG_PATH}/jasmin.cfg \
    && sed -i '/\[http-api\]/a bind=0.0.0.0' ${CONFIG_PATH}/jasmin.cfg \
    && sed -i '/\[smpp-server\]/a bind=0.0.0.0' ${CONFIG_PATH}/jasmin.cfg

ENTRYPOINT ["/compose-entrypoint.sh"]
CMD ["jasmind.py", "--enable-interceptor-client", "--enable-dlr-thrower", "--enable-dlr-lookup", "-u", "jcliadmin", "-p", "jclipwd"]
