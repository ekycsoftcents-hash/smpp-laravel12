APP_NAME="SMPP Control Plane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smpp
DB_USERNAME=smpp
DB_PASSWORD=smpp_secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbit-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=jasmin
RABBITMQ_PASSWORD=jasmin_secret
JASMIN_HTTP_URL=http://jasmin:1401/send
JASMIN_USERNAME=laravel_api
JASMIN_PASSWORD=laravel_secret
JASMIN_API_UID=laravel_api
JASMIN_DLR_URL=http://app/api/webhooks/jasmin/dlr
JASMIN_CONNECT_TIMEOUT=5
JASMIN_TIMEOUT=20
SMS_DEFAULT_CURRENCY=BDT

BALANCE_ALERT_THRESHOLD=1.00
BALANCE_ALERT_EMAIL=ops@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
