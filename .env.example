APP_NAME="REVE Native SMPP Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smpp
DB_USERNAME=smpp
DB_PASSWORD=smpp_secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbit-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=smpp
RABBITMQ_PASSWORD=smpp_secret
SMPP_GATEWAY_URL=http://gateway:3001
SMPP_GATEWAY_EVENTS_URL=http://gateway:3001/live/events
SMPP_GATEWAY_CONNECT_TIMEOUT=5
SMPP_GATEWAY_TIMEOUT=30
SMPP_GATEWAY_TOKEN=replace-with-a-long-random-secret
SMPP_CLIENT_BIND_HOST=0.0.0.0
SMPP_CLIENT_BIND_PORT=2775
GATEWAY_HTTP_PORT=3001
SMPP_ENQUIRE_LINK_INTERVAL=30000
SMPP_RECONNECT_MIN_MS=1000
SMPP_RECONNECT_MAX_MS=30000
SMPP_PROVIDER_CONNECT_TIMEOUT_MS=10000
SMS_DEFAULT_CURRENCY=BDT
BALANCE_ALERT_THRESHOLD=1.00
BALANCE_ALERT_EMAIL=ops@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
